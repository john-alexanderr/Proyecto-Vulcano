# Local development only. Replace this placeholder before starting the receiver.
VULCANO_WEBHOOK_SECRET=replace-me-with-a-random-secret-of-at-least-16-characters

# Dummy credentials accepted by LocalStack; never use these for AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

VULCANO_SQS_ENDPOINT_URL=http://localhost:4566
VULCANO_QUEUE_NAME=vulcano-events-queue
VULCANO_DLQ_NAME=vulcano-events-dlq
VULCANO_SQS_VISIBILITY_TIMEOUT_SECONDS=30
VULCANO_SQS_MAX_RECEIVE_COUNT=5
VULCANO_RECEIVER_WAIT_TIME_SECONDS=10

VULCANO_DESTINATION_URL=http://localhost:8080/webhook
VULCANO_TOLERANCE_SEC=300
VULCANO_LOG_PATH=logs/vulcano_events.log
